<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.calculadora.CalculadoraController"
      spacing="10"
      style="-fx-background-color: #f0f0f0;">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <TextField fx:id="display" 
               style="-fx-font-size: 24px; -fx-background-color: white; -fx-background-radius: 5;"
               editable="false"/>

    <GridPane hgap="5" vgap="5">
        <Button text="7" onAction="#handleNumber" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>
        <Button text="8" onAction="#handleNumber" GridPane.columnIndex="1" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>
        <Button text="9" onAction="#handleNumber" GridPane.columnIndex="2" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>
        <Button text="/" onAction="#handleOperator" GridPane.columnIndex="3" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>

        <Button text="4" onAction="#handleNumber" GridPane.rowIndex="1" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>
        <Button text="5" onAction="#handleNumber" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>
        <Button text="6" onAction="#handleNumber" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>
        <Button text="*" onAction="#handleOperator" GridPane.rowIndex="1" GridPane.columnIndex="3" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>

        <Button text="1" onAction="#handleNumber" GridPane.rowIndex="2" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>
        <Button text="2" onAction="#handleNumber" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>
        <Button text="3" onAction="#handleNumber" GridPane.rowIndex="2" GridPane.columnIndex="2" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>
        <Button text="-" onAction="#handleOperator" GridPane.rowIndex="2" GridPane.columnIndex="3" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>

        <Button text="0" onAction="#handleNumber" GridPane.rowIndex="3" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>
        <Button text="." onAction="#handleDecimal" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>
        <Button text="=" onAction="#handleEquals" GridPane.rowIndex="3" GridPane.columnIndex="2" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>
        <Button text="+" onAction="#handleOperator" GridPane.rowIndex="3" GridPane.columnIndex="3" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>

        <Button text="C" onAction="#handleClear" GridPane.rowIndex="4" GridPane.columnSpan="4" style="-fx-font-size: 18px; -fx-background-radius: 5;"/>
    </GridPane>
</VBox> 